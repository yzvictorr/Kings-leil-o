rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ok() { return request.resource.data.keys().hasOnly(['j', 't']) && request.resource.data.j is string && request.resource.data.j.size() < 900000; }
    match /games/{code} {
      allow read: if true;
      allow write: if code.size() == 4 && ok();
      match /in/{pid} { allow read: if true; allow write: if ok(); }
    }
    match /live/{code} { allow read: if true; allow write: if code.size() == 4 && ok(); }
    match /mev/{id} { allow read: if true; allow write: if ok(); }
    // fotos das cartas: todo mundo vê, só a conta do administrador grava
    match /photos/{shard} { allow read: if true; allow write: if request.auth != null && request.auth.uid in ['hzzHUn4k6FcFaAImc98zBN7pbvV2'] && ok(); }
    // perfil de quem entrou com Google: só o dono grava
    match /users/{uid} { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid && ok(); }
  }
}
